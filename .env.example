# Every variable the project reads. Copy to .env and fill in. Never commit .env.

# --- Postgres ---
DATABASE_URL=postgres://tickdoctor:tickdoctor@localhost:5432/tickdoctor
POSTGRES_USER=tickdoctor
POSTGRES_PASSWORD=tickdoctor
POSTGRES_DB=tickdoctor

# --- API ---
API_PORT=4000
# Server-side pepper mixed into API-key hashes (min 16 chars; 'change-me…' refused in production).
# Generate: openssl rand -hex 32
API_KEY_PEPPER=change-me-to-a-random-secret
# Secure flag on the td_session / td_csrf / td_oauth cookies. true behind HTTPS (prod).
# Empty = true when NODE_ENV=production, false otherwise. false is refused when NODE_ENV=production.
COOKIE_SECURE=false
# api-url written into the agent config snippet shown at server creation / key rotation
# (empty = WEB_PUBLIC_URL). For the Pi in dev use the Mac's Tailscale MagicDNS name, e.g.
# http://<mac-name>.<tailnet>.ts.net:3001 (a name, so it never needs updating)
AGENT_API_URL=
# Directory holding tickdoctor-agent-<semver>.jar builds for GET /downloads/agent/latest.jar
# (newest version wins; also the agentVersion in the setup response). Compose mounts
# ./agent/build/libs read-only at /agent-jars and sets this itself; for `pnpm dev` on the host use:
AGENT_JAR_DIR=../../agent/build/libs
# Process environment: development | test | production (production refuses dev-only settings)
NODE_ENV=development
# Optional: folder with the Drizzle SQL migrations (empty = apps/api/drizzle, resolved next to the code).
MIGRATIONS_DIR=

# --- Web ---
# Public origin of the site. The browser only ever talks to this origin (Caddy routes
# /api and /v1 to the API), so there is no CORS and no public API URL.
WEB_PUBLIC_URL=http://localhost:3000

# --- Email (Mailpit in dev: UI on http://localhost:8025) ---
# Auth emails (verify, magic link, "you already have an account", reset). Empty SMTP_HOST = emails are
# not sent, only logged (subject + recipient domain, never the link). Compose points the API at mailpit:1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# true = implicit TLS (port 465); STARTTLS is used automatically when offered
SMTP_SECURE=false
# Empty = "<brand name> <noreply@<brand domain>>" from packages/shared/src/brand.ts
MAIL_FROM="TickDoctor <noreply@tickdoctor.local>"

# --- Discord OAuth (Phase 5, optional) ---
# Sign-in with Discord is enabled only when all three are set (GET /api/auth/providers says so).
# Register the redirect in the Discord developer portal as <WEB_PUBLIC_URL>/api/auth/discord/callback,
# i.e. http://localhost:3000/api/auth/discord/callback in dev (through Caddy, not the API port).
# Only the Discord user id is stored; Discord tokens are never kept.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# --- Discord alerts (Phase 6) ---
# Key that encrypts alert webhook URLs at rest (AES-256-GCM): 32 random bytes, base64.
# Generate: openssl rand -base64 32
# Empty = owners can't save a Discord webhook (the Alerts tab gets a 503). Changing it makes saved webhooks
# unreadable (owners paste them again).
SECRETS_KEY=

# --- Beta (Phase 8) ---
# true = every account gets Pro limits (servers, retention, status page branding, ...) without changing any stored
# plan. Turning it off puts accounts back on their stored plan; the hourly retention job then trims history older
# than that plan keeps. Default false.
BETA_ALL_PRO=false

# --- Demo ---
# Server whose data powers /demo (falls back to seed data when offline)
DEMO_SERVER_ID=

# URL the Next.js server uses to reach the API for /api/* and /v1/* rewrites
# (http://api:4000 inside docker compose)
API_INTERNAL_URL=http://localhost:4000

# Trust the right-most X-Forwarded-For entry for rate limiting. Set true when the API
# sits behind exactly one proxy (the Next.js rewrite, or a reverse proxy). True in compose.
TRUST_PROXY=false

# Max new waitlist signups per rolling hour across all IPs (empty = 200)
WAITLIST_GLOBAL_CAP_PER_HOUR=200

# --- Findings recheck (Phase 4, contracts §6.4) ---
# How long a "marked fixed" incident finding must stay quiet (with fresh data) before it is confirmed fixed.
# Empty = 72. Lower it only for tests / live checks.
FINDING_RECHECK_INCIDENT_HOURS=
# Same for server-scope findings (config / host state); also the window after which an open server-scope
# finding whose condition is gone resolves itself. Empty = 15.
FINDING_RECHECK_SERVER_MINUTES=

# --- Tests ---
TEST_DATABASE_URL=postgres://tickdoctor:tickdoctor@localhost:5432/tickdoctor_test

# --- Pi test server access (Phase 2+) ---
# Bind address of the ingest-only listener (service `ingest`, port 3001) for the plugin on the Pi.
# The Pi reaches the Mac over Tailscale: set the Mac's Tailscale IP (stable per device).
# Default: localhost only. Tailscale must be running on the Mac.
INGEST_BIND_IP=127.0.0.1

# --- Ingest debug ---
# Expose GET /v1/debug/last?endpoint=metrics for the calling server's own key (dev only)
INGEST_DEBUG=false
# API bind address inside its container/host
API_HOST=0.0.0.0

# --- Dev admin access. Refused in production. ---
# Bearer token accepted on GET /api/servers/:id/* routes only (e2e/dev convenience); everything else needs a session.
DEV_ADMIN_TOKEN=
