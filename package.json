{
  "name": "tickdoctor",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm --filter @tickdoctor/web lint",
    "format": "prettier --write .",
    "seed": "pnpm --filter @tickdoctor/api exec tsx ../../scripts/seed.ts",
    "e2e": "playwright test -c e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "jscpd": "5.4.3",
    "typescript-eslint": "^8.72.1"
  }
}
