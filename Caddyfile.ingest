# Ingest-only entrance for the Pi test server (reached over Tailscale via the Mac's MagicDNS name).
# Serves only what the plugin needs; everything else is 404. Separate container so that a missing
# Tailscale interface at boot only delays this listener, never http://localhost:3000.
{
	admin off
	# Logging (GDPR): ERROR level only, and the IP, port, headers and query string are stripped from whatever is logged
	# (aborted SSE/RSC streams used to log warn lines with remote_ip, URI incl. tokens, User-Agent and Referer).
	log {
		output stderr
		level ERROR
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>uri regexp \?.* ""
				# Error strings from reverse_proxy can embed client addresses (write tcp a->CLIENT:port: broken pipe)
				error regexp `\[[0-9a-fA-F:.]+\](:[0-9]+)?|(?:[0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}|[0-9]{1,3}(?:\.[0-9]{1,3}){3}(:[0-9]+)?` "[redacted]"
				msg regexp `\[[0-9a-fA-F:.]+\](:[0-9]+)?|(?:[0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}|[0-9]{1,3}(?:\.[0-9]{1,3}){3}(:[0-9]+)?` "[redacted]"
			}
		}
	}
}

:3001 {
	@ingest path /v1/* /health /downloads/*
	handle @ingest {
		reverse_proxy api:4000
	}
	handle {
		respond 404
	}
	header -Server
	# No access log (GDPR).
}
