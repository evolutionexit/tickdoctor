# Production settings for docker-compose.prod.yml. Copy to .env.prod (gitignored, chmod 600) and fill in.
# Generate secrets with:  openssl rand -base64 32

DOMAIN=                    # e.g. tickdoctor.example (TODO: final name/domain)
ACME_EMAIL=                # for Let's Encrypt expiry notices

POSTGRES_USER=tickdoctor
POSTGRES_PASSWORD=         # openssl rand -base64 32
# age PUBLIC key (starts with age1) that encrypts the nightly dumps. The server never holds the private key.
# Generate on YOUR machine (not the server):  age-keygen -o backup-identity.txt   (prints "Public key: age1...")
# Put only the age1... line here; keep backup-identity.txt offline in 2 places (password manager + paper/USB).
# Without it backups cannot be restored. Never commit or paste a real identity (AGE-SECRET-KEY-...).
BACKUP_AGE_RECIPIENT=
POSTGRES_DB=tickdoctor

API_KEY_PEPPER=            # openssl rand -base64 32 — never change after launch (all API keys depend on it)
SECRETS_KEY=               # openssl rand -base64 32 — never change after launch (saved webhooks depend on it)

SMTP_HOST=                 # transactional email provider (TODO: choose; EU preferred)
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=                 # e.g. "TickDoctor <no-reply@tickdoctor.example>"

# Optional: Discord login (redirect URI is derived from DOMAIN)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Beta: every account gets Pro limits until this is set to false (see docs/go-public.md "end of the beta").
BETA_ALL_PRO=true

WAITLIST_GLOBAL_CAP_PER_HOUR=200
