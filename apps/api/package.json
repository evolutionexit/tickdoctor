{
  "name": "@tickdoctor/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@tickdoctor/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "nodemailer": "^10.4.0",
    "postgres": "^4.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
